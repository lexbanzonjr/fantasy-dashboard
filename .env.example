# Copy to .env (Docker) or .env.local (npm run dev) and fill in.

# The one login for the dashboard
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional: signs the login cookie. When unset, it's derived from the login,
# so changing the password signs you out everywhere.
SESSION_SECRET=

# Where the SQLite database lives. Docker sets this to /data (mounted from ./data).
DATA_DIR=./data

# URL you open the app at, used by the CBS bookmarklet
NEXT_PUBLIC_SITE_URL=http://localhost:6972

# 32 random bytes, base64, for encrypting the CBS token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CBS_TOKEN_KEY=

# Only used by scripts/cbs-probe.ts
CBS_LEAGUE_ID=
CBS_TOKEN=
