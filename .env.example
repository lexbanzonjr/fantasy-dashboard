# Copy to .env (Docker) or .env.local (npm run dev) and fill in.

# The one login for the dashboard
AUTH_USERNAME=
AUTH_PASSWORD=
# Optional: signs the login cookie. When unset, it's derived from the login,
# so changing the password signs you out everywhere.
SESSION_SECRET=

# Where the local SQLite database lives. Docker sets this to /data (mounted from ./data).
DATA_DIR=./data

# Vercel only: the Turso database. When these are unset, the app uses the local file in DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: URL you open the app at, used by the CBS bookmarklet. Leave blank to use the address the page is served from.
NEXT_PUBLIC_SITE_URL=

# 32 random bytes, base64, for encrypting the CBS token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CBS_TOKEN_KEY=

# Pickup research (Recommend pickups). Claude API key; the model defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Only used by scripts/cbs-probe.ts
CBS_LEAGUE_ID=
CBS_TOKEN=
